// Identifies the proxy as Lustral's; deploy.ps1 checks CompanyName before replacing or removing a winhttp.dll.
#include <winver.h>

#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LUSTRAL_VERSION_MAJOR,LUSTRAL_VERSION_MINOR,LUSTRAL_VERSION_PATCH,0
 PRODUCTVERSION LUSTRAL_VERSION_MAJOR,LUSTRAL_VERSION_MINOR,LUSTRAL_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Lustral Team"
            VALUE "FileDescription", "Lustral stage 0 (Unity mod loader); forwards winhttp.dll"
            VALUE "FileVersion", LUSTRAL_VERSION
            VALUE "InternalName", "lustral-stage0"
            VALUE "OriginalFilename", "winhttp.dll"
            VALUE "ProductName", "Lustral"
            VALUE "ProductVersion", LUSTRAL_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
