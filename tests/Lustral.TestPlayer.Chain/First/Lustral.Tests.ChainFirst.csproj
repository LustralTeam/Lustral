<Project>
  <!-- Part of the dependency chain test (tools/e2e.ps1): library <- first <- second. -->
  <Import Project="..\..\..\src\Lustral.Sdk\Sdk\Sdk.props" />

  <PropertyGroup>
    <LustralGame>LustralTestPlayer</LustralGame>
    <ModId>lustral.tests.chainfirst</ModId>
    <ModName>Chain test, first mod</ModName>
    <Version>1.0.0</Version>
    <LustralLaunchSettings>false</LustralLaunchSettings>
    <LustralRepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\..'))</LustralRepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <ModDependency Include="lustral.tests.chainlibrary" Version="^1.0" />
    <!-- Compiled against the library; Lustral provides it at runtime from the library's mod folder. -->
    <ProjectReference Include="..\Library\Lustral.Tests.ChainLibrary.csproj" Private="false" />
  </ItemGroup>

  <Import Project="..\..\..\src\Lustral.Sdk\Sdk\Sdk.targets" />
</Project>
