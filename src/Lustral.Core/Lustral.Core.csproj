<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <Description>Mod discovery, manifests, ordering, loading and logging. Does not reference Unity or IL2CPP types; references Harmony only to provide each mod with its own instance.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lustral.Api\Lustral.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HarmonyX" />
  </ItemGroup>

  <!--
    Tomlyn, renamed to Lustral.Tomlyn: on Mono, all mods share one domain with Lustral, so a mod referencing a different
    version of Tomlyn would otherwise receive Lustral's copy. The package only supplies the assembly to rename; Lustral.Core
    compiles against and ships the renamed copy, and projects referencing Lustral.Core never see the original. The
    renaming is done with Mono.Cecil.
  -->
  <ItemGroup>
    <PackageReference Include="Tomlyn" ExcludeAssets="compile;runtime" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Mono.Cecil" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <Reference Include="Lustral.Tomlyn" HintPath="$(IntermediateOutputPath)Lustral.Tomlyn.dll" Private="true" />
  </ItemGroup>

  <UsingTask TaskName="LustralRenameAssembly" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <NewName ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="$(PkgMono_Cecil)\lib\netstandard2.0\Mono.Cecil.dll" />
      <Using Namespace="Mono.Cecil" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // A new identity: name, module name, and no strong name (it would no longer match).
        using (var assembly = AssemblyDefinition.ReadAssembly(Source))
        {
            assembly.Name.Name = NewName;
            assembly.Name.PublicKey = new byte[0];
            assembly.Name.HasPublicKey = false;
            assembly.MainModule.Name = NewName + ".dll";
            assembly.MainModule.Attributes &= ~ModuleAttributes.StrongNameSigned;
            assembly.Write(Destination);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="LustralRenameTomlyn" BeforeTargets="ResolveAssemblyReferences"
          Inputs="$(PkgTomlyn)\lib\$(TargetFramework)\Tomlyn.dll" Outputs="$(IntermediateOutputPath)Lustral.Tomlyn.dll">
    <LustralRenameAssembly Source="$(PkgTomlyn)\lib\$(TargetFramework)\Tomlyn.dll" Destination="$(IntermediateOutputPath)Lustral.Tomlyn.dll" NewName="Lustral.Tomlyn" />
  </Target>

  <!-- Layouts for reading the game's version from globalgamemanagers, generated by tools/playersettings-layouts.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="GameData\PlayerSettingsLayouts.txt" LogicalName="Lustral.PlayerSettingsLayouts.txt" />
  </ItemGroup>

  <!-- Per-mod load contexts require AssemblyLoadContext; Mono uses DomainModAssemblyLoader instead. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="Loading\ModLoadContext.cs;Loading\ContextModAssemblyLoader.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lustral.Core.Tests" />
  </ItemGroup>

</Project>
